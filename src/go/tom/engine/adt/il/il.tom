%op DerivTree derivrule(Name:String, Post:Deriv, Pre:DerivTree, Cond:Seq) {
  is_fsym(t)     { func() bool { _, ok := ($t).(*DerivruleDerivTree); return ok }() }
  get_slot(Name,t) { ($t).(*DerivruleDerivTree).Name }
  get_slot(Post,t) { ($t).(*DerivruleDerivTree).Post }
  get_slot(Pre,t) { ($t).(*DerivruleDerivTree).Pre }
  get_slot(Cond,t) { ($t).(*DerivruleDerivTree).Cond }
  make(Name,Post,Pre,Cond)       { MakeDerivrule($Name,$Post,$Pre,$Cond) }
}

%op DerivTree derivrule2(Name:String, Post:Deriv, Pre:DerivTree, Pre2:DerivTree, Cond:Seq) {
  is_fsym(t)     { func() bool { _, ok := ($t).(*Derivrule2DerivTree); return ok }() }
  get_slot(Name,t) { ($t).(*Derivrule2DerivTree).Name }
  get_slot(Post,t) { ($t).(*Derivrule2DerivTree).Post }
  get_slot(Pre,t) { ($t).(*Derivrule2DerivTree).Pre }
  get_slot(Pre2,t) { ($t).(*Derivrule2DerivTree).Pre2 }
  get_slot(Cond,t) { ($t).(*Derivrule2DerivTree).Cond }
  make(Name,Post,Pre,Pre2,Cond)       { MakeDerivrule2($Name,$Post,$Pre,$Pre2,$Cond) }
}

