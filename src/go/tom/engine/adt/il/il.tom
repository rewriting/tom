%include { string.tom }
%include { int.tom }
%include { aterm.tom }

%typeterm Symbol {
  implement      { Symbol }
  is_sort(t)     { func() bool { _, ok := ($t).(Symbol); return ok }() }
  equals(t1,t2)  { ($t1).Equivalent($t2) }
}

