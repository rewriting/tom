  is_fsym(t)     { func() bool { _, ok := ($t).(*SequenceInstr); return ok }() }
  get_slot(Instrlist,t) { ($t).(*SequenceInstr).Instrlist }
  make(Instrlist)       { MakeSequence($Instrlist) }
