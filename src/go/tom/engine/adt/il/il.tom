%op Symbol fsymbol(Name:String) {
  is_fsym(t)     { func() bool { _, ok := ($t).(*FsymbolSymbol); return ok }() }
  get_slot(Name,t) { ($t).(*FsymbolSymbol).Name }
  make(Name)       { MakeFsymbol($Name) }
}

%op Variable var(Name:String) {
  is_fsym(t)     { func() bool { _, ok := ($t).(*VarVariable); return ok }() }
  get_slot(Name,t) { ($t).(*VarVariable).Name }
  make(Name)       { MakeVar($Name) }
}

