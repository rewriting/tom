# The Go copies of the compiler ADTs: src/go/tom/gom/adt and
# src/go/tom/engine/adt hold only the .gom sources (committed). Their Go
# code and Tom mapping are generated locally by
# `mage -d magefiles -w . bootstrap`, with the gomgo of the Go amorce
# stable/go/tom (a full copy of module tom, as stable/ holds the Java code
# that bootstraps the Java compiler); `mage -d magefiles -w . promoteGo`
# updates the amorce.
/src/go/tom/gom/adt/*.go
/src/go/tom/gom/adt/*.tom
/src/go/tom/engine/adt/*.go
/src/go/tom/engine/adt/*.tom
