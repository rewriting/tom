Tom(concCode(TargetLanguageToCode(TL("\npackage gom.testrulesortlist.sorted.types.sorted;\nimport gom.testrulesortlist.sorted.types.*;\n\n\n\npublic abstract class Mix extends gom.testrulesortlist.sorted.types.Sorted implements java.util.Collection<gom.testrulesortlist.sorted.types.Element>  {\npublic static boolean greaterThan(Element o1, Element o2) {\n          if (o1.compareToLPO(o2)>0)\n            return true;\n          return false;\n        }\n\n\n  /**\n   * Returns the number of arguments of the variadic operator\n   *\n   * @return the number of arguments of the variadic operator\n   */\n  @Override\n  public int length() {\n    int res = 0;\n    gom.testrulesortlist.sorted.types.Sorted tl = this;\n    while(tl instanceof gom.testrulesortlist.sorted.types.sorted.ConsMix) {\n      res += 1;\n      tl = tl.getTailMix();\n      if(tl instanceof Mix == false) {\n        res += 1;\n      }\n    }\n    return res;\n/*\n    if(this instanceof gom.testrulesortlist.sorted.types.sorted.ConsMix) {\n      gom.testrulesortlist.sorted.types.Sorted tl = this.getTailMix();\n      if (tl instanceof Mix) {\n        return 1+((Mix)tl).length();\n      } else {\n        return 2;\n      }\n    } else {\n      return 0;\n    }\n    */\n  }\n\n  public static gom.testrulesortlist.sorted.types.Sorted fromArray(gom.testrulesortlist.sorted.types.Element[] array) {\n    gom.testrulesortlist.sorted.types.Sorted res = gom.testrulesortlist.sorted.types.sorted.EmptyMix.make();\n    for(int i = array.length; i>0;) {\n      res = gom.testrulesortlist.sorted.types.sorted.ConsMix.make(array[--i],res);\n    }\n    return res;\n  }\n\n  /**\n   * Inverses the term if it is a list\n   *\n   * @return the inverted term if it is a list, otherwise the term itself\n   */\n  @Override\n  public gom.testrulesortlist.sorted.types.Sorted reverse() {\n    if(this instanceof gom.testrulesortlist.sorted.types.sorted.ConsMix) {\n      gom.testrulesortlist.sorted.types.Sorted cur = this;\n      gom.test