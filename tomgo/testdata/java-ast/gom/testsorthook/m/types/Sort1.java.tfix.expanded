eam containing the ATerm\n   * @return the term from the Stream\n   * @throws java.io.IOException if a problem occurs with the stream\n   */\n  public static gom.testsorthook.m.types.Sort1 fromStream(java.io.InputStream stream) throws java.io.IOException {\n    return fromTerm(atermFactory.readFromFile(stream),idConv);\n  }\n\n  /**\n   * Apply a conversion on the ATerm and returns a gom.testsorthook.m.types.Sort1\n   *\n   * @param trm ATerm to convert into a Gom term\n   * @param atConv ATermConverter used to convert the ATerm\n   * @return the Gom term\n   * @throws IllegalArgumentException\n   */\n  public static gom.testsorthook.m.types.Sort1 fromTerm(aterm.ATerm trm, tom.library.utils.ATermConverter atConv) {\n    aterm.ATerm convertedTerm = atConv.convert(trm);\n    gom.testsorthook.m.types.Sort1 tmp;\n    java.util.ArrayList<gom.testsorthook.m.types.Sort1> results = new java.util.ArrayList<gom.testsorthook.m.types.Sort1>();\n\n    tmp = gom.testsorthook.m.types.sort1.a.fromTerm(convertedTerm,atConv);\n    if(tmp!=null) {\n      results.add(tmp);\n    }\n    tmp = gom.testsorthook.m.types.sort1.b.fromTerm(convertedTerm,atConv);\n    if(tmp!=null) {\n      results.add(tmp);\n    }\n    switch(results.size()) {\n      case 0:\n        throw new IllegalArgumentException(trm + \" is not a Sort1\");\n      case 1:\n        return results.get(0);\n      default:\n        java.util.logging.Logger.getLogger(\"Sort1\").log(java.util.logging.Level.WARNING,\"There were many possibilities ({0}) in {1} but the first one was chosen: {2}\",new Object[] {results.toString(), \"gom.testsorthook.m.types.Sort1\", results.get(0).toString()});\n        return results.get(0);\n    }\n  }\n\n  /**\n   * Apply a conversion on the ATerm contained in the String and returns a gom.testsorthook.m.types.Sort1 from it\n   *\n   * @param s String containing the ATerm\n   * @param atConv ATerm Converter used to convert the ATerm\n   * @return the Gom term\n   */\n  public static gom.testsorth