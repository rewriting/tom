e attribute gom.testacu.acu.types.T which just has been set\n   */\n  @Override\n  public gom.testacu.acu.types.T setHeadconc(gom.testacu.acu.types.T set_arg) {\n    return make(set_arg, _Tailconc);\n  }\n  \n  /**\n   * Returns the attribute gom.testacu.acu.types.T\n   *\n   * @return the attribute gom.testacu.acu.types.T\n   */\n  @Override\n  public gom.testacu.acu.types.T getTailconc() {\n    return _Tailconc;\n  }\n\n  /**\n   * Sets and returns the attribute gom.testacu.acu.types.T\n   *\n   * @param set_arg the argument to set\n   * @return the attribute gom.testacu.acu.types.T which just has been set\n   */\n  @Override\n  public gom.testacu.acu.types.T setTailconc(gom.testacu.acu.types.T set_arg) {\n    return make(_Headconc, set_arg);\n  }\n  \n  /* AbstractType */\n  /**\n   * Returns an ATerm representation of this term.\n   *\n   * @return an ATerm representation of this term.\n   */\n  @Override\n  public aterm.ATerm toATerm() {\n    aterm.ATerm res = super.toATerm();\n    if(res != null) {\n      // the super class has produced an ATerm (may be a variadic operator)\n      return res;\n    }\n    return atermFactory.makeAppl(\n      atermFactory.makeAFun(symbolName(),getArity(),false),\n      new aterm.ATerm[] {getHeadconc().toATerm(), getTailconc().toATerm()});\n  }\n\n  /**\n   * Apply a conversion on the ATerm contained in the String and returns a gom.testacu.acu.types.T from it\n   *\n   * @param trm ATerm to convert into a Gom term\n   * @param atConv ATerm Converter used to convert the ATerm\n   * @return the Gom term\n   */\n  public static gom.testacu.acu.types.T fromTerm(aterm.ATerm trm, tom.library.utils.ATermConverter atConv) {\n    trm = atConv.convert(trm);\n    if(trm instanceof aterm.ATermAppl) {\n      aterm.ATermAppl appl = (aterm.ATermAppl) trm;\n      if(symbolName.equals(appl.getName()) && !appl.getAFun().isQuoted()) {\n        return make(\ngom.testacu.acu.types.T.fromTerm(appl.getArgument(0),atConv), gom.testacu.acu.types.T.fromTe