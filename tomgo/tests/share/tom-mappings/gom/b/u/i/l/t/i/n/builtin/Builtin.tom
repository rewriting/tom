%typeterm Wrapper {
  implement      { Builtin.types.Wrapper }
  is_sort(t)     { ($t instanceof Builtin.types.Wrapper) }
  equals(t1,t2)  { ($t1.equals($t2)) }
}

%typeterm ListInt {
  implement      { Builtin.types.ListInt }
  is_sort(t)     { ($t instanceof Builtin.types.ListInt) }
  equals(t1,t2)  { ($t1.equals($t2)) }
}

%typeterm ListLong {
  implement      { Builtin.types.ListLong }
