%oplist Wrapper concWrap( Wrapper* ) {
  is_fsym(t)       { ($t instanceof Builtin.types.Wrapper) }
  make_empty()     { new Builtin.types.Wrapper.EmptyconcWrap() }
  make_insert(e,l) { new Builtin.types.Wrapper.ConsconcWrap($e, $l) }
  get_head(l)      { ((Builtin.types.Wrapper.ConsconcWrap)$l).getHeadconcWrap() }
  get_tail(l)      { ((Builtin.types.Wrapper.ConsconcWrap)$l).getTailconcWrap() }
  is_empty(l)      { ($l instanceof Builtin.types.Wrapper.EmptyconcWrap) }
}

