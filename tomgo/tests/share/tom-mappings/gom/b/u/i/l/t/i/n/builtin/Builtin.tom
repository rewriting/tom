  equals(t1,t2)  { ($t1.equals($t2)) }
}

%op Wrapper Int(i:int) {
  is_fsym(t)     { ($t != null) && ($t instanceof Builtin.types.wrapper.Int) }
  get_slot(i,t) { ((Builtin.types.wrapper.Int)$t).getI() }
  make(i)       { new Builtin.types.wrapper.Int($i) }
}

%op Wrapper IntBis(i:int) {
  is_fsym(t)     { ($t != null) && ($t instanceof Builtin.types.wrapper.IntBis) }
  get_slot(i,t) { ((Builtin.types.wrapper.IntBis)$t).getI() }
  make(i)       { new Builtin.types.wrapper.IntBis($i) }
}

