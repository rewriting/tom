%typeterm Bool {
  implement      { RuleBool.types.Bool }
  is_sort(t)     { ($t instanceof RuleBool.types.Bool) }
  equals(t1,t2)  { ($t1.equals($t2)) }
}

%op Bool True() {
  is_fsym(t)     { ($t != null) && ($t instanceof RuleBool.types.bool.True) }
  make()       { new RuleBool.types.bool.True() }
}

%op Bool False() {
  is_fsym(t)     { ($t != null) && ($t instanceof RuleBool.types.bool.False) }
  make()       { new RuleBool.types.bool.False() }
}

%op Bool Not(b:Bool) {
  is_fsym(t)     { ($t != null) && ($t instanceof RuleBool.types.bool.Not) }
  get_slot(b,t) { ((RuleBool.types.bool.Not)$t).getB() }
  make(b)       { new RuleBool.types.bool.Not($b) }
}

%op Bool And(l:Bool, r:Bool) {
  is_fsym(t)     { ($t != null) && ($t instanceof RuleBool.types.bool.And) }
  get_slot(l,t) { ((RuleBool.types.bool.And)$t).getL() }
  get_slot(r,t) { ((RuleBool.types.bool.And)$t).getR() }
  make(l,r)       { new RuleBool.types.bool.And($l,$r) }
}

%op Bool Or(l:Bool, r:Bool) {
  is_fsym(t)     { ($t != null) && ($t instanceof RuleBool.types.bool.Or) }
  get_slot(l,t) { ((RuleBool.types.bool.Or)$t).getL() }
  get_slot(r,t) { ((RuleBool.types.bool.Or)$t).getR() }
  make(l,r)       { new RuleBool.types.bool.Or($l,$r) }
}

