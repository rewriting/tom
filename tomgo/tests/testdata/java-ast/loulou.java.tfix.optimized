Tom(concCode(TargetLanguageToCode(TL("include<stdio.h>\ninclude<stdlib.h>\n\ndefine ZERO  0\ndefine SUC   1\n\n%typeterm Nat {\n  implement { int }\n  is_sort(t) { (0==0) }\n}\n\n%op Nat zero() {\n  is_fsym(t) { $t==0 }\n}\n\n%op Nat suc(p:Nat) {\n  is_fsym(t) { $t>0 }\n  get_slot(p,t) { $t-1 }\n  make(t) { $t+1 }\n}\n\nint plus(int t1, int t2) {\n  %match(Nat t1, Nat t2) {\n    x,zero()   -> { return \140x; }\n    x,suc(y) -> { return \140suc(plus(x,y)); }\n  }\n}\n\nvoid test_failed(char *category) {\n  fprintf(stderr, \"test \'%s\' failed!\\n\", category);\n  exit(1);\n}\ndefine test_assert(cat,cond) if(!(cond)) test_failed(cat)\n\nint main() {\n\n    // printf(\"res = %d\\n\", plus(10,10) );\n  \n  test_assert(\"1+1 = 2\", (plus(1,1) == 2));\n  test_assert(\"10+10 = 20\", (plus(10,10) == 20));\n  \n  return(0);\n}\n",TextPosition(1,2),TextPosition(44,1)))))