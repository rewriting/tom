// Port of test/TestOptimizer.t (compiled with --optimize, as test/build.xml
// does).
// port: `_ = s`, as Go rejects an unused local variable: s is only the
// subject of the %match, whose patterns need not inspect it (the Java
// code generated by legacy/ does not reference it either).
// port: no main — `go test` runs the tests (the original main only launched JUnit).
package testoptimizer

import "testing"

	%include { string.tom }

func Test1(t *testing.T) {
		var s string = ""
		// used to make the optimizer fail
		// with a stackoverflow exception
		%match(String s) {
			a@x	-> {
				// nothing
			}
			_a@_x	-> {
				// nothing
			}
		}
		_ = s
	}
