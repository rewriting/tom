package main

// A Tom+Go program on the engine ADT (tom/engine/adt, mapping adt.tom
// generated by gomgo): a list match on Code, a %strategy visiting TL,
// over a term read with CodeFromString. adt.tom includes aterm.tom,
// hence the import of tom/library/aterm.

import (
	"fmt"
	"os"

	. "tom/engine/adt"
	"tom/library/aterm"
	"tom/library/sl"
)

%include { adt.tom }
%include { sl.tom }

var total int

%strategy CountTL() extends Identity() {
  visit TargetLanguage {
    TL(code, _, _) -> { total += len(`code) }
  }
}

func kind(c Code) string {
  %match(c) {
    Tom(concCode(_*, DeclarationToCode(TypeTermDecl(Name(n), _, _)), _*)) -> { return "first typeterm: " + `n }
  }
  return "none"
}

func main() {
	b, err := os.ReadFile(os.Args[1])
	if err != nil {
		panic(err)
	}
	c := CodeFromString(string(b))
	if _, err := sl.MakeTopDown(`CountTL()).VisitLight(c, sl.VisitableIntrospector{}); err != nil {
		panic(err)
	}
	fmt.Println(kind(c), "TL bytes:", total)
}

var _ = aterm.GetInstance
