%oplist RefClassTracelinkInstructionList concRefClassTracelinkInstruction( RefClassTracelinkInstruction* ) {
  is_fsym(t)       { func() bool { _, ok := ($t).(*ConcRefClassTracelinkInstructionRefClassTracelinkInstructionList); return ok }() }
  make_empty()     { EmptyConcRefClassTracelinkInstruction() }
  make_insert(e,l) { ConsConcRefClassTracelinkInstruction($e,$l) }
  get_head(l)      { ($l).GetHeadconcRefClassTracelinkInstruction() }
  get_tail(l)      { ($l).GetTailconcRefClassTracelinkInstruction() }
  is_empty(l)      { ($l).IsEmptyconcRefClassTracelinkInstruction() }
}

