%op TypeConstraint FalseTypeConstraint() {
  is_fsym(t)     { func() bool { _, ok := ($t).(*FalseTypeConstraintTypeConstraint); return ok }() }
  make()       { MakeFalseTypeConstraint() }
}

%op TypeConstraintList EmptyconcTypeConstraint() {
  is_fsym(t) { ($t).IsEmptyconcTypeConstraint() }
  make() { EmptyConcTypeConstraint() }
}

%op TypeConstraintList ConsconcTypeConstraint(HeadconcTypeConstraint:TypeConstraint, TailconcTypeConstraint:TypeConstraintList) {
  is_fsym(t) { ($t).IsConsconcTypeConstraint() }
  get_slot(HeadconcTypeConstraint, t) { ($t).GetHeadconcTypeConstraint() }
  get_slot(TailconcTypeConstraint, t) { ($t).GetTailconcTypeConstraint() }
  make(t0, t1) { ConsConcTypeConstraint($t0, $t1) }
}

%oplist TypeConstraintList concTypeConstraint( TypeConstraint* ) {
  is_fsym(t)       { func() bool { _, ok := ($t).(*ConcTypeConstraintTypeConstraintList); return ok }() }
  make_empty()     { EmptyConcTypeConstraint() }
  make_insert(e,l) { ConsConcTypeConstraint($e,$l) }
  get_head(l)      { ($l).GetHeadconcTypeConstraint() }
  get_tail(l)      { ($l).GetTailconcTypeConstraint() }
  is_empty(l)      { ($l).IsEmptyconcTypeConstraint() }
}

