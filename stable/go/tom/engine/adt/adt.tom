  get_slot(HeadconcRefClassTracelinkInstruction, t) { ($t).GetHeadconcRefClassTracelinkInstruction() }
  get_slot(TailconcRefClassTracelinkInstruction, t) { ($t).GetTailconcRefClassTracelinkInstruction() }
