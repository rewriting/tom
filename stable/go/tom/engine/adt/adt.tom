%op RefClassTracelinkInstructionList ConsconcRefClassTracelinkInstruction(HeadconcRefClassTracelinkInstruction:RefClassTracelinkInstruction, TailconcRefClassTracelinkInstruction:RefClassTracelinkInstructionList) {
