%op BQTerm EmptyComposite() {
  is_fsym(t) { ($t).IsEmptyComposite() }
  make() { EmptyComposite() }
}

%op BQTerm ConsComposite(HeadComposite:CompositeMember, TailComposite:BQTerm) {
  is_fsym(t) { ($t).IsConsComposite() }
  get_slot(HeadComposite, t) { ($t).GetHeadComposite() }
  get_slot(TailComposite, t) { ($t).GetTailComposite() }
  make(t0, t1) { ConsComposite($t0, $t1) }
}

%oplist BQTerm Composite( CompositeMember* ) {
  is_fsym(t)       { func() bool { _, ok := ($t).(*CompositeBQTerm); return ok }() }
  make_empty()     { EmptyComposite() }
  make_insert(e,l) { ConsComposite($e,$l) }
  get_head(l)      { ($l).GetHeadComposite() }
  get_tail(l)      { ($l).GetTailComposite() }
  is_empty(l)      { ($l).IsEmptyComposite() }
}

