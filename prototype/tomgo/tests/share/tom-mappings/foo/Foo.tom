%typeterm T {
  implement      { Foo.types.T }
  is_sort(t)     { ($t instanceof Foo.types.T) }
  equals(t1,t2)  { ($t1.equals($t2)) }
}

%op T f(t1:String, t2:T) {
  is_fsym(t)     { ($t != null) && ($t instanceof Foo.types.t.f) }
  get_slot(t1,t) { ((Foo.types.t.f)$t).getT1() }
  get_slot(t2,t) { ((Foo.types.t.f)$t).getT2() }
  make(t1,t2)       { new Foo.types.t.f($t1,$t2) }
}

%op T h(t3:T) {
  is_fsym(t)     { ($t != null) && ($t instanceof Foo.types.t.h) }
  get_slot(t3,t) { ((Foo.types.t.h)$t).getT3() }
  make(t3)       { new Foo.types.t.h($t3) }
}

%op T i(t4:int) {
  is_fsym(t)     { ($t != null) && ($t instanceof Foo.types.t.i) }
  get_slot(t4,t) { ((Foo.types.t.i)$t).getT4() }
