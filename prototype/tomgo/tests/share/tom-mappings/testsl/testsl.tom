%typeterm Term {
  implement      { testsl.types.Term }
  is_sort(t)     { ($t instanceof testsl.types.Term) }
  equals(t1,t2)  { ($t1.equals($t2)) }
}

%op Term a() {
  is_fsym(t)     { ($t != null) && ($t instanceof testsl.types.term.a) }
  make()       { new testsl.types.term.a() }
}

%op Term b() {
  is_fsym(t)     { ($t != null) && ($t instanceof testsl.types.term.b) }
  make()       { new testsl.types.term.b() }
}

%op Term c() {
  is_fsym(t)     { ($t != null) && ($t instanceof testsl.types.term.c) }
  make()       { new testsl.types.term.c() }
}

%op Term f(arg1:Term) {
  is_fsym(t)     { ($t != null) && ($t instanceof testsl.types.term.f) }
  get_slot(arg1,t) { ((testsl.types.term.f)$t).getArg1() }
  make(arg1)       { new testsl.types.term.f($arg1) }
}

%op Term g(arg1:Term, arg2:Term) {
  is_fsym(t)     { ($t != null) && ($t instanceof testsl.types.term.g) }
  get_slot(arg1,t) { ((testsl.types.term.g)$t).getArg1() }
  get_slot(arg2,t) { ((testsl.types.term.g)$t).getArg2() }
  make(arg1,arg2)       { new testsl.types.term.g($arg1,$arg2) }
}

%op Term h(arg1:Term, arg2:Term, arg3:Term) {
  is_fsym(t)     { ($t != null) && ($t instanceof testsl.types.term.h) }
  get_slot(arg1,t) { ((testsl.types.term.h)$t).getArg1() }
  get_slot(arg2,t) { ((testsl.types.term.h)$t).getArg2() }
  get_slot(arg3,t) { ((testsl.types.term.h)$t).getArg3() }
  make(arg1,arg2,arg3)       { new testsl.types.term.h($arg1,$arg2,$arg3) }
}

%oplist Term l( Term* ) {
  is_fsym(t)       { ($t instanceof testsl.types.Term) }
  make_empty()     { new testsl.types.Term.Emptyl() }
  make_insert(e,l) { new testsl.types.Term.Consl($e, $l) }
  get_head(l)      { ((testsl.types.Term.Consl)$l).getHeadl() }
  get_tail(l)      { ((testsl.types.Term.Consl)$l).getTaill() }
  is_empty(l)      { ($l instanceof testsl.types.Term.Emptyl) }
}

%op Term m(i:int) {
  is_fsym(t)     { ($t != null) && ($t instanceof testsl.types.term.m) }
  get_slot(i,t) { ((testsl.types.term.m)$t).getI() }
  make(i)       { new testsl.types.term.m($i) }
}

